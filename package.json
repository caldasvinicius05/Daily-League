{
  "name": "daily-league",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "tsx scripts/fetch-ddragon.ts",
    "predev": "npm run data",
    "dev": "concurrently -n client,server -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "prebuild": "npm run data",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "balance": "tsx scripts/balance.ts",
    "balance:check": "tsx scripts/balance.ts 20 --from 2026-01-01 --check",
    "test": "tsx scripts/check-replay.ts",
    "riot:collect": "tsx scripts/riot/collect.ts",
    "riot:build": "tsx scripts/riot/build-matchups.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
